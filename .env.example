# Ferro Labs AI Gateway — Environment Variables
# Copy and set values in your environment (DO NOT commit real secrets).
#
# Local dev:  set -a; source .env; set +a; ferrogw serve
#             (set -a exports what follows — a bare `source` only assigns these
#              as shell variables, which a child process never sees)
# Docker:     docker run --env-file .env -p 8080:8080 ghcr.io/ferro-labs/ai-gateway:latest
# Kubernetes: use K8s Secrets with envFrom
#
# docker run --env-file and kubectl --from-env-file read every value literally:
# a trailing "# comment" on a NAME=value line becomes part of the value. Keep
# each comment on a line of its own.
#
# A provider is REGISTERED only when its credential is present, so set at least
# one. Provider URL overrides point at a proxy, self-hosted server, or regional
# endpoint. Write API-root values exactly as the vendor documents them, version
# segment included. Every supported provider variable is listed below.

# ── Master Key (required for dashboard/admin) ─────
# Generate with: ferrogw init
MASTER_KEY=

# ── Admin CLI ─────────────────────────────────────
# Gateway base URL
# FERROGW_URL=http://localhost:8080
# Falls back to MASTER_KEY when unset
# FERROGW_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# PROVIDERS — self-serve API keys (instant signup)
# ═══════════════════════════════════════════════════════════════════════════

# ── Frontier labs ──────────────────────────────────
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# MISTRAL_API_KEY=
# MISTRAL_BASE_URL=
# COHERE_API_KEY=
# COHERE_BASE_URL=https://api.cohere.com/v2
# PERPLEXITY_API_KEY=
# PERPLEXITY_BASE_URL=
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=
# AI21_API_KEY=
# AI21_BASE_URL=

# ── Fast inference / OSS serving / aggregators ─────
# GROQ_API_KEY=
# GROQ_BASE_URL=
# CEREBRAS_API_KEY=
# CEREBRAS_BASE_URL=
# TOGETHER_API_KEY=
# TOGETHER_BASE_URL=
# FIREWORKS_API_KEY=
# FIREWORKS_BASE_URL=
# API key for OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# DEEPINFRA_API_KEY=
# DEEPINFRA_BASE_URL=
# NOVITA_API_KEY=
# NOVITA_BASE_URL=
# SAMBANOVA_API_KEY=
# SAMBANOVA_BASE_URL=
# NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_BASE_URL=
# Alibaba DashScope
# QWEN_API_KEY=
# QWEN_BASE_URL=

# ── Hosting platforms ──────────────────────────────
# HUGGING_FACE_API_KEY=
# Optional: a dedicated Inference Endpoint URL
# HUGGING_FACE_ENDPOINT=
# Note: _API_TOKEN, not _API_KEY
# REPLICATE_API_TOKEN=
# REPLICATE_BASE_URL=
# Comma-separated; Replicate's model set is config-driven
# REPLICATE_TEXT_MODELS=meta/meta-llama-3-8b-instruct
# REPLICATE_IMAGE_MODELS=black-forest-labs/flux-schnell

# ═══════════════════════════════════════════════════════════════════════════
# PROVIDERS — cloud / enterprise (need a cloud account, not just a key)
# ═══════════════════════════════════════════════════════════════════════════

# ── Azure OpenAI ───────────────────────────────────
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# Your chat deployment name
# AZURE_OPENAI_DEPLOYMENT=
# A preview version is required for /audio/speech
# AZURE_OPENAI_API_VERSION=2024-10-21

# ── Azure AI Foundry ───────────────────────────────
# AZURE_FOUNDRY_API_KEY=
# AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
# AZURE_FOUNDRY_API_VERSION=

# ── AWS Bedrock ────────────────────────────────────
# AWS_REGION=us-east-1
# Auth is EITHER a Bedrock bearer token …
# AWS_BEARER_TOKEN_BEDROCK=
# … OR SigV4 keys (falls back to the instance/role credential chain if unset):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Google Vertex AI ───────────────────────────────
# VERTEX_AI_PROJECT_ID=
# VERTEX_AI_REGION=us-central1
# Auth is EITHER an API key …
# VERTEX_AI_API_KEY=
# … OR a service account JSON string:
# VERTEX_AI_SERVICE_ACCOUNT_JSON=
# With neither set, Application Default Credentials are used; for a local file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Databricks ─────────────────────────────────────
# Note: _TOKEN, not _API_KEY
# DATABRICKS_TOKEN=
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com

# ── Cloudflare Workers AI ──────────────────────────
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_BASE_URL=

# ═══════════════════════════════════════════════════════════════════════════
# PROVIDERS — self-hosted / local
# ═══════════════════════════════════════════════════════════════════════════

# ── Ollama (local) ─────────────────────────────────
# OLLAMA_HOST=http://localhost:11434
# Narrows what /v1/models advertises. Not OLLAMA_MODELS — that is Ollama's own
# models directory, and the gateway does not read it.
# FERRO_OLLAMA_MODELS=llama3,codellama

# ── Ollama Cloud (hosted) ──────────────────────────
# OLLAMA_API_KEY=
# OLLAMA_CLOUD_BASE_URL=
# OLLAMA_CLOUD_MODELS=gpt-oss:120b

# ── Batch + Responses backends ─────────────────────
# The /v1/files, /v1/batches and /v1/responses id sub-routes pin to one backend;
# set these in the config file (batch_target / responses_target), not here — they
# name a configured target's virtual_key, e.g. openai.

# ── Server ─────────────────────────────────────────
# PORT=8080
# GATEWAY_CONFIG=config.yaml
# Turns on production-mode startup safety checks
# GATEWAY_ENV=production
# LOG_LEVEL=info
# Dev only; blocked in production mode
# ALLOW_UNAUTHENTICATED_PROXY=false
# Mounts authenticated /debug/pprof/* routes
# ENABLE_PPROF=false
# CORS_ORIGINS is matched literally — there is no wildcard. List each origin.
# CORS_ORIGINS=http://localhost:3000
# CIDRs whose X-Forwarded-For is honored
# TRUSTED_PROXIES=10.0.0.0/8

# ── Model catalog and discovery ────────────────────
# Override the remote model catalog URL
# FERRO_MODEL_CATALOG_URL=
# Set to 0 to skip the remote catalog fetch
# FERRO_MODEL_CATALOG_TIMEOUT=10s
# A Go duration, e.g. 6h; unset disables live discovery
# FERRO_MODEL_DISCOVERY_INTERVAL=

# ── Observability (OpenTelemetry tracing) ──────────
# Setting it turns tracing on; base OTLP endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Signal-specific endpoint; takes precedence
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Comma-separated key=value exporter headers
# OTEL_EXPORTER_OTLP_HEADERS=
# Signal-specific headers; takes precedence
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=

# ── Storage (default: in-memory) ───────────────────
# Recommended: sqlite for local dev, postgres for production
# API_KEY_STORE_BACKEND=sqlite
# API_KEY_STORE_DSN=data/keys.db
# CONFIG_STORE_BACKEND=sqlite
# CONFIG_STORE_DSN=data/config.db
# REQUEST_LOG_STORE_BACKEND=sqlite
# REQUEST_LOG_STORE_DSN=data/logs.db

# ── Rate Limiting ──────────────────────────────────
# RATE_LIMIT_RPS=100
# RATE_LIMIT_BURST=200

# ── Test-only ──────────────────────────────────────
# FERROGW_TEST_POSTGRES_DSN=postgres://user:pass@localhost:5432/ferrogw_test?sslmode=require
# Live provider tests also read LIVE_<PROVIDER>_<SURFACE>_MODEL (e.g.
# LIVE_OPENAI_TRANSCRIPTION_MODEL) for surfaces whose model is not catalog-pinned.
